<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <!-- Microsoft.NET.Test.Sdk 18.x pulls in Microsoft.Testing.Platform, whose
             targets re-add the TestContainer capability after this file's body is
             evaluated. Disable the testing platform so the Remove below takes effect
             and Visual Studio stops treating this benchmark project as a test project. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>

        <RootNamespace>Nfun.Benchmarks</RootNamespace>

        <LangVersion>latest</LangVersion>

        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="QuickBench" Version="0.1.0" />
        <PackageReference Include="nunit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\NFun\NFun.csproj" />
    </ItemGroup>

    <!-- Prevent Visual Studio from treating this benchmark project as a test
         container; VS checks TestContainer capability in addition to IsTestProject. -->
    <ItemGroup>
        <ProjectCapability Remove="TestContainer" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="History\" />
    </ItemGroup>

</Project>
